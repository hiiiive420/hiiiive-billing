generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ADMIN
  BILLING
  VIEWER
}

enum InvoiceLifecycleStatus {
  DRAFT
  ISSUED
  SUPERSEDED
  VOID
  WRITTEN_OFF
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  OTHER
}

enum InvoiceRelationType {
  REPLACED_BY
}

model Organization {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String
  slug             String                   @unique
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  clients          Client[]
  clientContacts   ClientContact[]
  services         Service[]
  memberships      OrganizationMembership[]
  invoices         Invoice[]
  invoiceItems     InvoiceItem[]
  invoiceSequences InvoiceSequence[]
  payments         Payment[]
  invoiceRelations InvoiceRelation[]
}

model User {
  id          String                   @id @default(uuid()) @db.Uuid
  email       String                   @unique
  displayName String?
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
}

model Client {
  id                                  String          @id @default(uuid()) @db.Uuid
  organizationId                      String          @db.Uuid
  name                                String
  businessRegistrationOrTaxIdentifier String?
  phone                               String?
  email                               String?
  billingAddress                      String?
  notes                               String?
  active                              Boolean         @default(true)
  createdAt                           DateTime        @default(now())
  updatedAt                           DateTime        @updatedAt
  organization                        Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts                            ClientContact[]
  invoices                            Invoice[]

  // Enables a contact foreign key that enforces matching tenant and client.
  @@unique([organizationId, id])
  @@index([organizationId, name])
}

model ClientContact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  clientId       String       @db.Uuid
  name           String
  email          String?
  phone          String?
  billingContact Boolean      @default(false)
  primaryContact Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client         Client       @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, clientId])
}

model Service {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  name             String
  description      String?
  defaultUnitPrice Decimal?      @db.Decimal(19, 4)
  currencyCode     String        @default("LKR") @db.VarChar(3)
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoiceItems     InvoiceItem[]

  // Enables invoice item foreign keys that enforce matching tenant and service.
  @@unique([organizationId, id])
  @@index([organizationId, name])
}

model Invoice {
  id                           String                 @id @default(uuid()) @db.Uuid
  organizationId               String                 @db.Uuid
  clientId                     String                 @db.Uuid
  invoiceNumber                String?
  lifecycleStatus              InvoiceLifecycleStatus @default(DRAFT)
  paymentStatus                InvoicePaymentStatus   @default(UNPAID)
  currencyCode                 String                 @default("LKR") @db.VarChar(3)
  invoiceDate                  DateTime?              @db.Date
  dueDate                      DateTime?              @db.Date
  issuedAt                     DateTime?
  clientNameSnapshot           String?
  clientBillingAddressSnapshot String?
  clientEmailSnapshot          String?
  clientPhoneSnapshot          String?
  subtotal                     Decimal                @default(0) @db.Decimal(19, 4)
  discountLabel                String?
  discountAmount               Decimal                @default(0) @db.Decimal(19, 4)
  grandTotal                   Decimal                @default(0) @db.Decimal(19, 4)
  notes                        String?
  paymentTerms                 String?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  organization                 Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client                       Client                 @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  items                        InvoiceItem[]
  payments                     Payment[]
  sourceRelations              InvoiceRelation[]      @relation("InvoiceRelationSource")
  targetRelations              InvoiceRelation[]      @relation("InvoiceRelationTarget")

  // Enables tenant-safe composite foreign keys from invoice items.
  @@unique([organizationId, id])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, lifecycleStatus])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, clientId])
  @@index([organizationId, invoiceDate])
  @@index([organizationId, dueDate])
}

model InvoiceItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  invoiceId      String       @db.Uuid
  serviceId      String?      @db.Uuid
  description    String
  quantity       Decimal      @db.Decimal(19, 4)
  unitPrice      Decimal      @db.Decimal(19, 4)
  lineTotal      Decimal      @db.Decimal(19, 4)
  position       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice        Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)
  service        Service?     @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, invoiceId, position])
  @@index([organizationId, serviceId])
}

model InvoiceSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  key            String       @default("DEFAULT")
  prefix         String       @default("I")
  nextValue      Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  invoiceId      String        @db.Uuid
  amount         Decimal       @db.Decimal(19, 4)
  paidAt         DateTime
  method         PaymentMethod
  reference      String?
  internalNote   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice        Invoice       @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, invoiceId, paidAt])
  @@index([organizationId, paidAt])
}

model InvoiceRelation {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  sourceInvoiceId String              @db.Uuid
  targetInvoiceId String              @db.Uuid
  relationType    InvoiceRelationType
  reason          String
  createdAt       DateTime            @default(now())
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceInvoice   Invoice             @relation("InvoiceRelationSource", fields: [organizationId, sourceInvoiceId], references: [organizationId, id], onDelete: Restrict)
  targetInvoice   Invoice             @relation("InvoiceRelationTarget", fields: [organizationId, targetInvoiceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, targetInvoiceId, relationType])
  @@index([organizationId, sourceInvoiceId])
}
