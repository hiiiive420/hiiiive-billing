DATABASE_URL=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=
DEV_AUTH_EMAIL=developer@example.test

# Outbound issued invoice email (server-only)
INVOICE_FROM_EMAIL=billing@example.test
INVOICE_FROM_NAME=Example Billing
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Optional server-only OpenAI invoice suggestion (no key is required to build/test)
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=your-enabled-model

# Internal daily recurring invoice runner (server-only; configure a random secret of at least 32 characters)
RECURRING_INVOICE_CRON_SECRET=

# Absolute path to the server-installed Chromium executable used for PDFs
#PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
